{
  "name": "threadline-prototype",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "prestart": "node scripts/check-node.cjs",
    "sync": "node --env-file-if-exists=.env src/sync.ts",
    "auth:google": "node --env-file-if-exists=.env src/adapters/calendar/auth.ts",
    "import:malcolm": "node --env-file-if-exists=.env src/adapters/malcolm/import.ts",
    "preimport:malcolm": "node scripts/check-node.cjs",
    "import:leapsome": "node --env-file-if-exists=.env src/adapters/leapsome/import.ts",
    "preimport:leapsome": "node scripts/check-node.cjs",
    "check": "node src/check.ts",
    "typecheck": "tsc --noEmit",
    "serve": "node src/server.ts --no-sync",
    "presync": "node scripts/check-node.cjs",
    "preauth:google": "node scripts/check-node.cjs",
    "precheck": "node scripts/check-node.cjs",
    "pretypecheck": "node scripts/check-node.cjs",
    "preserve": "node scripts/check-node.cjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "6.0.3"
  }
}
