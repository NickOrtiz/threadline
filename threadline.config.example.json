{
  "$comment": "Copy to threadline.config.json and edit. Secrets live in .env, never here.",
  "workspace": {
    "id": "work",
    "name": "Acme Studio",
    "mode": "Work"
  },
  "displayName": "Alex",
  "timezone": "America/New_York",
  "workday": {
    "start": "09:00",
    "end": "17:00"
  },
  "teamwork": {
    "site": "https://your-company.teamwork.com",
    "completedLookbackDays": 30,
    "excludeProjectIds": [
      "100001"
    ],
    "projects": {
      "100002": {
        "id": "northwind",
        "name": "Northwind"
      },
      "100003": {
        "id": "juniper",
        "name": "Juniper"
      }
    },
    "stageStatus": {
      "Icebox": "blocked"
    }
  },
  "calendar": {
    "calendarIds": [
      "primary"
    ],
    "lookaheadDays": 7
  },
  "codeHosts": [
    {
      "id": "github-work",
      "type": "github",
      "host": "github.com",
      "auth": {
        "gh": {
          "user": "octocat"
        }
      },
      "repos": {
        "acme/northwind-website": "northwind",
        "acme/juniper-*": "juniper",
        "acme-internal/*": null
      }
    }
  ],
  "continuity": {
    "awayHours": 8
  },
  "server": {
    "port": 8080,
    "syncIntervalMinutes": 15
  },
  "relay": {
    "url": "https://relay.example.com/api/mcp",
    "projects": {
      "northwind": [
        "northwind-site"
      ],
      "juniper": [
        "juniper-redesign"
      ]
    },
    "projectUrl": "https://relay.example.com/projects/{project}",
    "documentUrl": "https://relay.example.com/projects/{project}/docs/{path}"
  },
  "malcolm": {
    "enabled": false,
    "email": "alex@example.com",
    "maxAgeHours": 12,
    "model": "haiku"
  },
  "leapsome": {
    "enabled": false,
    "includeArchived": true,
    "maxAgeHours": 24,
    "model": "haiku"
  }
